# Public URL, without trailing slash. Set to your Vercel/custom domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL and publishable key (not a service role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used for validated public submissions and private photo streaming.
SUPABASE_SERVICE_ROLE_KEY=
# UUID of the sales business, created using supabase/bootstrap.sql.
SALES_BUSINESS_ID=
# Random secret (openssl rand -hex 32), used to hash rate-limit identifiers.
RATE_LIMIT_SECRET=
# Tests on a disposable Supabase project only; never commit actual values.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
